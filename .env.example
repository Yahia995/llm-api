GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default LLM deployment framework target
# Supported Models: llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama3-8b-8192

# Local Stack:  redis://localhost:6379/0
# Render Cloud: Create a free serverless instance at https://upstash.com
# WARNING: Render deployments REQUIRE the secure 'rediss://' protocol for TLS.
REDIS_URL=rediss://default:your_upstash_password@your-db-id.upstash.io:6379

# Note: SQLAlchemy mandates the explicit 'postgresql://' dialect prefix.
DATABASE_URL=postgresql://user:password@ep-your-cluster-id.region.aws.neon.tech/neondb?sslmode=require

# Local compose orchestration routing: http://mlflow:5000
# Production Render URL:               https://onrender.com
MLFLOW_TRACKING_URI=http://mlflow:5000

# Dynamically assigned by Render on boot; defaults to 8000 for local testing
PORT=8000
