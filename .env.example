# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use by default (can be overridden per request)
# Options: llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama3-8b-8192

# Local:  redis://localhost:6379/0
# Koyeb:  use Koyeb's managed Redis add-on URL
REDIS_URL=redis://localhost:6379/0

# Local docker-compose: http://mlflow:5000
# Koyeb:                http://<your-mlflow-service>.koyeb.app
MLFLOW_TRACKING_URI=http://mlflow:5000

# Neon Postgres connection string — get it at https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
